{
	"name": "degird/cliezoo",
	"description": "Cliezoo: run your whole client business inside WordPress.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"homepage": "https://cliezoo.com/",
	"support": {
		"source": "https://github.com/degird/cliezoo",
		"issues": "https://github.com/degird/cliezoo/issues"
	},
	"require": {
		"php": ">=8.1",
		"lbuchs/webauthn": "^2.2",
		"woocommerce/action-scheduler": "^4.2"
	},
	"require-dev": {
		"brianhenryie/strauss": "^0.22",
		"phpunit/phpunit": "^9.6",
		"yoast/phpunit-polyfills": "^4.0"
	},
	"autoload": {
		"psr-4": {
			"Cliezoo\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Cliezoo\\Tests\\": "tests/php/"
		}
	},
	"config": {
		"platform": {
			"php": "8.1.0"
		},
		"optimize-autoloader": true,
		"sort-packages": true
	},
	"extra": {
		"strauss": {
			"target_directory": "vendor-prefixed",
			"namespace_prefix": "Cliezoo\\Vendor\\",
			"classmap_prefix": "Cliezoo_Vendor_",
			"constant_prefix": "CLIEZOO_VENDOR_",
			"packages": [
				"lbuchs/webauthn"
			],
			"delete_vendor_packages": true,
			"include_modified_date": false,
			"include_author": false
		}
	},
	"scripts": {
		"prefix-vendor": [
			"strauss"
		]
	}
}
